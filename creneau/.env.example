# === Créneau — configuration ===

# Base SQLite (chemin dans le conteneur ; le volume Docker la persiste)
DATABASE_URL="file:./dev.db"

# URL publique de l'app (liens dans les emails, OAuth Google)
BASE_URL="http://localhost:3000"

# Secret de session (générer avec : openssl rand -hex 32)
SESSION_SECRET="change-me"

# Compte admin créé au premier démarrage (seed)
ADMIN_EMAIL="david.torz@adti.fr"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="David"

# --- Emails (confirmations + rappels) ---
# Sans SMTP configuré, les emails sont simplement affichés dans les logs.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Créneau <rdv@adti.fr>"

# --- Google Calendar (occupations + création d'événement + lien Meet) ---
# Console Google Cloud → APIs & Services → Credentials → OAuth client ID
# (type "Web application", redirect URI : ${BASE_URL}/api/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- SMS (confirmations + rappels, en plus des emails) ---
# SMS_PROVIDER : "brevo" ou "ovh". Sans configuration, SMS journalisés.
SMS_PROVIDER=""
SMS_SENDER="Creneau"          # nom d'expéditeur (11 caractères max)
BREVO_API_KEY=""              # si SMS_PROVIDER=brevo
OVH_APP_KEY=""                # si SMS_PROVIDER=ovh
OVH_APP_SECRET=""
OVH_CONSUMER_KEY=""
OVH_SERVICE_NAME=""           # ex. sms-ab12345-1

# --- Surveillance (alertes si la réservation ne marche plus) ---
# Email alerté en cas de panne (défaut : ADMIN_EMAIL) + mobile optionnel.
HEALTH_ALERT_EMAIL=""
HEALTH_ALERT_PHONE=""
